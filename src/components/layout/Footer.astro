</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border-color);
    background-color: var(--bg-surface);
    position: relative;
    z-index: 10;
  }

  .footer-marquee {
    overflow: hidden;
    white-space: nowrap;
    border-bottom: 1px solid var(--border-color);
    background-color: var(--color-night);
    color: #F4F1EB;
    padding: 10px 0;
  }

  .marquee-track {
    display: inline-flex;
    animation: marqueeScroll 35s linear infinite;
  }

  .marquee-segment {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    padding-right: 2rem;
  }

  @keyframes marqueeScroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  .footer-content {
    padding-top: clamp(3rem, 6vw, 5rem);
    padding-bottom: 2rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.5fr;
    gap: clamp(24px, 4vw, 48px);
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

  .footer-tagline {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.125rem;
    line-height: 1.35;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
  }

  .footer-bio {
    margin-bottom: 1.25rem;
  }

  .footer-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 10px;
    background-color: var(--bg-surface-dim);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
  }

  .footer-col-title {
    margin-bottom: 1rem;
    color: var(--text-dim);
  }

  .footer-links-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-link {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-muted);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: color var(--transition-fast);
  }

  .footer-link:hover {
    color: var(--accent-color);
  }

  .ext-arrow {
    font-size: 0.9em;
    color: var(--text-dim);
  }

  .easter-egg-wrapper {
    margin-top: 1.25rem;
  }

  .easter-egg-btn {
    padding: 6px 12px;
    background-color: var(--bg-surface-dim);
    border: 1px dashed var(--border-color);
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .easter-egg-btn:hover {
    border-color: var(--accent-color);
    color: var(--accent-color);
  }

  .easter-egg-box {
    margin-bottom: 2rem;
    background-color: var(--color-night);
    color: #ECE8E0;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    padding: 16px;
    box-shadow: var(--shadow-md);
  }

  .easter-egg-box[hidden] {
    display: none;
  }

  .easter-egg-header {
    display: flex;
    justify-content: space-between;
    padding-bottom: 8px;
    border-bottom: 1px solid #2C2E33;
    margin-bottom: 12px;
    color: var(--text-dim);
  }

  .easter-egg-body {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.6;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .signal-text {
    color: var(--accent-color);
    font-weight: 700;
  }

  .footer-bottom {
    padding-top: 2rem;
    border-top: 1px solid var(--border-color);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
  }

  .footer-bottom-right {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
    .brand-col {
      grid-column: span 2;
    }
  }

  @media (max-width: 600px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
    .brand-col {
      grid-column: span 1;
    }
  }
</style>

<script>
  function setupEasterEgg() {
    const btn = document.getElementById('easter-egg-btn');
    const terminal = document.getElementById('easter-egg-terminal');

    if (!btn || !terminal) return;

    btn.addEventListener('click', () => {
      const isHidden = terminal.hidden;
      terminal.hidden = !isHidden;
      btn.setAttribute('aria-expanded', String(isHidden));
    });
  }

  setupEasterEgg();
  document.addEventListener('astro:page-load', setupEasterEgg);
</script>
