---
const currentYear = new Date().getFullYear();
---

<footer class="quiet-footer">
  <div class="container">
    <a
      href="/"
      class="footer-wordmark"
      aria-label="IMPURE® — Punit Pal homepage"
    >
      IMPURE®
    </a>
    <nav aria-label="Social links">
      <a
        href="https://github.com/ShahiTechnovation"
        target="_blank"
        rel="noopener noreferrer"
      >
        GitHub ↗
      </a>
      <a
        href="https://x.com/its_punit05"
        target="_blank"
        rel="noopener noreferrer"
      >
        X ↗
      </a>
      <a
        href="https://linkedin.com/in/punit05"
        target="_blank"
        rel="noopener noreferrer"
      >
        LinkedIn ↗
      </a>
      <a
        href="https://farcaster.xyz/0x9899"
        target="_blank"
        rel="noopener noreferrer"
      >
        Farcaster ↗
      </a>
    </nav>
    <span>© {currentYear} Punit Pal</span>
    <details>
      <summary>Colophon</summary>
      <p>
        Built with Astro and TypeScript. Inspired by paper, editorial typography
        and the original IMPURE identity. No third-party trackers.
      </p>
    </details>
  </div>
</footer>
<style>
  .quiet-footer {
    border-top: 1px solid var(--editorial-rule);
    padding: 30px 0;
  }
  .quiet-footer > .container {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px 40px;
  }
  .footer-wordmark {
    font: 700 1.25rem var(--font-display);
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    margin-right: auto;
  }
  nav a,
  summary {
    font-size: 0.75rem;
    padding: 12px 0;
    min-height: 44px;
  }
  span {
    font-size: 0.7rem;
    color: var(--text-muted);
  }
  summary {
    cursor: pointer;
  }
  details p {
    max-width: 400px;
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  @media (max-width: 600px) {
    nav {
      width: 100%;
      order: 3;
      gap: 22px;
    }
    details {
      order: 4;
    }
  }
</style>
