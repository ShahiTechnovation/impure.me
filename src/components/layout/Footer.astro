        <div class="footer-col-title tech-label">DOSSIER INDEX</div>
        <ul class="footer-links-list">
          <li><a href="/" class="footer-link">01 // Overview</a></li>
          <li><a href="/build" class="footer-link">02 // Engineering Portfolio</a></li>
          <li><a href="/grow" class="footer-link">03 // Developer Relations &amp; GTM</a></li>
          <li><a href="/story" class="footer-link">04 // Personal Journey &amp; Education</a></li>
          <li><a href="/contact" class="footer-link">05 // Direct Transmission</a></li>
        </ul>
      </div>

      <!-- Col 3: Ecosystem & Verified Channels -->
      <div class="footer-col">
        <div class="footer-col-title tech-label">ECOSYSTEM &amp; SOCIALS</div>
