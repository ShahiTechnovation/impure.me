---
interface Props { eager?: boolean }
const { eager = false } = Astro.props;
---
<figure class="builder-flag" data-builder-flag>
  <div class="flag-stage">
    <img src="/images/work/builder-base-flag.webp" width="1200" height="900" alt="White satin Builder Base flag with the blue monogram, folded against a dark background" loading={eager ? 'eager' : 'lazy'} decoding="async" />
    <canvas aria-hidden="true"></canvas>
    <button type="button" hidden aria-pressed="false">Pause flag</button>
  </div>
  <figcaption><span>Builder Base / A place to begin.</span><span>Interactive flag study</span></figcaption>
</figure>
<style>
  .builder-flag{min-width:0;margin:0}
  .flag-stage{background:#0a0a0a;aspect-ratio:4/3;position:relative;overflow:hidden;user-select:none;-webkit-user-select:none}
  img{display:block;width:100%;height:100%;object-fit:contain;pointer-events:none}
  canvas{position:absolute;inset:0;width:100%;height:100%;opacity:0;pointer-events:none;touch-action:none}
  .builder-flag[data-ready] canvas{opacity:1;pointer-events:auto;cursor:grab}
  .builder-flag[data-ready] canvas.grabbing{cursor:grabbing}
  button{position:absolute;right:12px;bottom:12px;z-index:2;min-height:44px;padding:8px 14px;border:1px solid #777;background:#171717;color:#f5f3ed;font:500 .75rem var(--font-body);cursor:pointer}
  button[hidden]{display:none}
  figcaption{display:flex;justify-content:space-between;gap:16px;font-size:.72rem}
</style>
<script>
  for (const figure of document.querySelectorAll<HTMLElement>('[data-builder-flag]')) {
    const canvas = figure.querySelector('canvas')!;
    const button = figure.querySelector('button')!;
    const connection = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
    let renderer: { ready: Promise<unknown>; play(): void; pause(): void; destroy(): void } | undefined;
    let loading = false, visible = false, paused = false, failed = false, ready = false;
    const eligible = () => !connection?.saveData;
    async function sync() {
      if (!eligible() || failed) {
        renderer?.pause(); delete figure.dataset.ready; button.hidden = true;
        return;
      }
      if (!visible || document.hidden) { renderer?.pause(); return; }
      if (!renderer && !loading && !failed) {
        loading = true;
        try {
          const { createFlag } = await import('../../scripts/builder-flag.js');
          if (!eligible() || !visible || document.hidden) return;
          renderer = createFlag(canvas);
          await renderer!.ready;
          ready = true;
        } catch { failed = true; renderer?.destroy(); renderer = undefined; }
        finally { loading = false; }
      }
      if (renderer && ready && !failed && eligible() && visible && !document.hidden) {
        figure.dataset.ready = ''; button.hidden = false;
        if (paused) renderer.pause(); else renderer.play();
      }
    }
    button.addEventListener('click', () => {
      paused = !paused;
      button.textContent = paused ? 'Play flag' : 'Pause flag';
      button.setAttribute('aria-pressed', String(paused));
      void sync();
    });
    const observer = new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; void sync(); }, { threshold: .05 });
    observer.observe(figure);
    document.addEventListener('visibilitychange', sync);
    canvas.addEventListener('webglcontextlost', () => {
      failed = true; renderer?.pause(); delete figure.dataset.ready; button.hidden = true;
    });
    window.addEventListener('pagehide', () => { renderer?.pause(); });
    window.addEventListener('pageshow', () => { void sync(); });
  }
</script>