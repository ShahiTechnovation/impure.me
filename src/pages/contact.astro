---
// src/pages/contact.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact // Transmission Channel — Punit Pal"
  description="Connect with Punit Pal for technical engineering collaboration, Developer Relations leadership, ecosystem GTM distribution, and speaking."
>
  <div class="contact-page-wrapper">
    <!-- Header Hero -->
    <section class="contact-hero-section" aria-label="Contact Introduction">
      <div class="container">
        <div class="contact-meta-bar animate-reveal">
          <span class="dossier-stamp solid-signal">SECURE COMMS // TRANSMISSION PROTOCOL</span>
          <span class="tech-micro">FASTEST CHANNELS: EMAIL &amp; TWITTER / X</span>
          <span class="tech-micro hide-mobile">RESPONSE LATENCY: &lt; 24 HOURS</span>
        </div>

        <div class="contact-header-content animate-reveal">
          <h1 class="heading-xl contact-title">
            START TRANSMISSION<span class="signal-dot">.</span>
          </h1>
          <p class="text-lead contact-subtitle">
            Have an ambitious system to engineer, a developer ecosystem to scale, or a high-signal hackathon to launch?
          </p>
          <p class="text-body contact-desc">
            I partner with forward-thinking protocol foundations, AI and dev-tooling startups, and technical founders who value deep engineering credibility, community-led distribution, and relentless execution speed.
          </p>
        </div>
      </div>
    </section>

    <!-- Main Contact Grid -->
    <section class="section-padding" aria-label="Transmission Channels and Inquiry Form">
      <div class="container">
        <div class="contact-main-grid">
          <!-- Col 1: Distinct Collaboration Opportunities & Channels -->
          <div class="contact-info-col animate-reveal">
            <div class="info-group">
              <span class="tech-label-signal">01 // COLLABORATION AVENUES</span>
              <div class="avenues-list">
                <div class="avenue-card dossier-card">
                  <h3 class="heading-sm">Technical Founding &amp; Engineering</h3>
                  <p class="text-body-sm">
                    Compilers (Python/Rust/WASM), AI multi-agent orchestration, blockchain assurance infrastructure, and developer tooling.
                  </p>
                </div>
                <div class="avenue-card dossier-card">
                  <h3 class="heading-sm">Developer Relations &amp; Advocacy</h3>
                  <p class="text-body-sm">
                    Hands-on technical workshops, developer documentation, SDK usability auditing, and open source starter repository authoring.
                  </p>
                </div>
                <div class="avenue-card dossier-card">
                  <h3 class="heading-sm">Ecosystem GTM &amp; Hackathon Growth</h3>
                  <p class="text-body-sm">
                    Designing hackathon tracks, builder acquisition funnels, and multi-city distribution programs via Builder Base (64K+ audience).
                  </p>
                </div>
                <div class="avenue-card dossier-card">
                  <h3 class="heading-sm">Technical Workshops &amp; Speaking</h3>
                  <p class="text-body-sm">
                    Presentations on AST compiler lowering, Model Context Protocol (MCP), and multi-agent decentralized workflows.
                  </p>
                </div>
              </div>
            </div>

            <!-- Direct Electronic Channels -->
            <div class="info-group">
              <span class="tech-label-signal">02 // VERIFIED ELECTRONIC CHANNELS</span>
              <div class="channels-box dossier-card">
                <div class="channel-row">
                  <span class="tech-label">FOUNDER EMAIL:</span>
                  <a href="mailto:punit@builderbase.xyz" class="channel-link inline-link tech-micro">
                    punit@builderbase.xyz
                  </a>
                </div>
                <div class="channel-row">
                  <span class="tech-label">TECHNICAL / DEV:</span>
                  <a href="mailto:dev@pyvax.xyz" class="channel-link inline-link tech-micro">
                    dev@pyvax.xyz
                  </a>
                </div>
                <div class="channel-row">
                  <span class="tech-label">X / TWITTER:</span>
                  <a href="https://x.com/its_punit05" target="_blank" rel="noopener noreferrer" class="channel-link inline-link tech-micro">
                    @its_punit05 &nearr;
                  </a>
                </div>
                <div class="channel-row">
                  <span class="tech-label">GITHUB:</span>
                  <a href="https://github.com/ShahiTechnovation" target="_blank" rel="noopener noreferrer" class="channel-link inline-link tech-micro">
                    github.com/ShahiTechnovation &nearr;
                  </a>
                </div>
                <div class="channel-row">
                  <span class="tech-label">LINKEDIN:</span>
                  <a href="https://linkedin.com/in/punit05" target="_blank" rel="noopener noreferrer" class="channel-link inline-link tech-micro">
                    linkedin.com/in/punit05 &nearr;
                  </a>
                </div>
                <div class="channel-row">
                  <span class="tech-label">BUILDER BASE:</span>
                  <a href="https://www.builderbase.xyz" target="_blank" rel="noopener noreferrer" class="channel-link inline-link tech-micro">
                    builderbase.xyz &nearr;
                  </a>
                </div>
              </div>
            </div>
          </div>

          <!-- Col 2: Direct Interactive Transmission Form -->
          <div class="contact-form-col animate-reveal">
            <div class="dossier-card form-card">
              <div class="form-header-bar">
                <span class="tech-label">TRANSMISSION DISPATCH // DIRECT</span>
                <span class="tech-micro">ID: MSG-INBOUND</span>
              </div>

              <form id="transmission-form" class="transmission-form" novalidate>
                <!-- Name Field -->
                <div class="form-field">
                  <label for="form-name" class="tech-label">
                    YOUR NAME OR ENTITY <span class="required-star">*</span>
                  </label>
                  <input
                    type="text"
                    id="form-name"
                    name="name"
                    class="form-input tech-micro"
                    placeholder="e.g. Satoshi Nakamoto / Protocol Foundation"
                    required
                  />
                  <span class="field-error tech-micro" id="name-error"></span>
                </div>

                <!-- Email Field -->
                <div class="form-field">
                  <label for="form-email" class="tech-label">
                    ELECTRONIC MAIL <span class="required-star">*</span>
                  </label>
                  <input
                    type="email"
                    id="form-email"
                    name="email"
                    class="form-input tech-micro"
                    placeholder="e.g. partner@protocol.org"
                    required
                  />
                  <span class="field-error tech-micro" id="email-error"></span>
                </div>

                <!-- Inquiry Category -->
                <div class="form-field">
                  <label for="form-category" class="tech-label">
                    TRANSMISSION OBJECTIVE <span class="required-star">*</span>
                  </label>
                  <select id="form-category" name="category" class="form-select tech-micro" required>
                    <option value="Technical Engineering Collaboration">01 // Technical Engineering Collaboration</option>
                    <option value="Developer Relations / Dev Advocacy">02 // Developer Relations &amp; Tooling</option>
                    <option value="Ecosystem GTM & Hackathons">03 // Ecosystem GTM &amp; Hackathon Growth</option>
                    <option value="Speaking, Workshops & Keynotes">04 // Speaking, Workshops &amp; Keynotes</option>
                    <option value="General Technical Inquiry">05 // General Technical Inquiry</option>
                  </select>
                </div>

                <!-- Message Field -->
                <div class="form-field">
                  <label for="form-message" class="tech-label">
                    BRIEF DISPATCH / SYSTEM SPECIFICATION <span class="required-star">*</span>
                  </label>
                  <textarea
                    id="form-message"
                    name="message"
                    rows="5"
                    class="form-textarea text-body-sm"
                    placeholder="Describe your architecture, protocol, bounty requirements, or partnership scope..."
                    required
                  ></textarea>
                  <span class="field-error tech-micro" id="message-error"></span>
                </div>

                <!-- Submit Button -->
                <div class="form-submit-row">
                  <button type="submit" id="submit-btn" class="btn btn-primary form-submit-btn">
                    <span>OPEN IN EMAIL CLIENT</span>
                    <span aria-hidden="true">&rarr;</span>
                  </button>
                  <span class="tech-micro form-hint">
                    * Prepares a structured message in your default email client addressed to punit@builderbase.xyz.
                  </span>
                </div>
              </form>

              <!-- Prepared Payload Box with Clipboard Fallback -->
              <div id="form-success-box" class="form-success-alert" hidden>
                <div class="success-header tech-label-signal">EMAIL MESSAGE PREPARED</div>
                <p class="text-body-sm" id="payload-notice">
                  Your email client has been launched with your structured inquiry. If your browser does not open a mail client automatically, you can copy the message or write directly to <a href="mailto:punit@builderbase.xyz" class="inline-link">punit@builderbase.xyz</a>.
                </p>
                <div class="payload-actions" style="margin-top: 10px; display: flex; gap: 10px; flex-wrap: wrap;">
                  <button type="button" id="copy-payload-btn" class="btn btn-secondary tech-micro">
                    <span>COPY MESSAGE TO CLIPBOARD</span>
                  </button>
                  <a href="mailto:punit@builderbase.xyz" class="btn tech-micro">
                    <span>RETRY MAILTO</span>
                    <span class="ext-arrow">&nearr;</span>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .contact-hero-section {
    padding-top: clamp(2.5rem, 5vw, 4.5rem);
    padding-bottom: clamp(2rem, 4vw, 3.5rem);
    border-bottom: 1px solid var(--border-color);
    background-color: var(--bg-primary);
  }

  .contact-meta-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 16px;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    margin-bottom: 24px;
    flex-wrap: wrap;
    gap: 10px;
  }

  .contact-header-content {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 840px;
  }

  .contact-title {
    margin: 0;
  }

  .signal-dot {
    color: var(--accent-color);
  }

  .contact-subtitle {
    color: var(--text-muted);
  }

  /* Contact Main Grid */
  .contact-main-grid {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: clamp(24px, 4.5vw, 48px);
    align-items: start;
  }

  .contact-info-col {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .info-group {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .avenues-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .avenue-card {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    border-radius: var(--radius-sm);
  }

  .channels-box {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    border-radius: var(--radius-sm);
  }

  .channel-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 10px;
    border-bottom: 1px dashed var(--border-color);
  }

  .channel-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  /* Form Card */
  .form-card {
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .form-header-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 20px;
    background-color: var(--bg-surface-dim);
    border-bottom: 1px solid var(--border-color);
  }

  .transmission-form {
    padding: clamp(20px, 3.5vw, 32px);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .required-star {
    color: var(--accent-color);
  }

  .form-input,
  .form-select,
  .form-textarea {
    width: 100%;
    padding: 10px 14px;
    background-color: var(--bg-surface-dim);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    font-family: inherit;
    outline: none;
    transition: border-color var(--transition-fast);
  }

  .form-input:focus,
  .form-select:focus,
  .form-textarea:focus {
    border-color: var(--accent-color);
    background-color: var(--bg-surface);
  }

  .field-error {
    color: var(--accent-color);
    min-height: 14px;
  }

  .form-submit-row {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 8px;
  }

  .form-submit-btn {
    width: 100%;
    padding: 14px;
  }

  .form-hint {
    color: var(--text-dim);
  }

  .form-success-alert {
    margin: 20px;
    padding: 16px;
    background-color: var(--color-signal-subtle);
    border: 1px solid var(--accent-color);
    border-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-success-alert[hidden] {
    display: none;
  }

  @media (max-width: 900px) {
    .contact-main-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  function setupContactForm() {
    const form = document.getElementById('transmission-form') as HTMLFormElement | null;
    const successBox = document.getElementById('form-success-box');
    if (!form) return;

    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const nameInput = document.getElementById('form-name') as HTMLInputElement | null;
      const emailInput = document.getElementById('form-email') as HTMLInputElement | null;
      const catInput = document.getElementById('form-category') as HTMLSelectElement | null;
      const msgInput = document.getElementById('form-message') as HTMLTextAreaElement | null;

      const nameErr = document.getElementById('name-error');
      const emailErr = document.getElementById('email-error');
      const msgErr = document.getElementById('message-error');

      // Clear previous errors
      if (nameErr) nameErr.textContent = '';
      if (emailErr) emailErr.textContent = '';
      if (msgErr) msgErr.textContent = '';

      let hasError = false;

      if (!nameInput?.value.trim()) {
        if (nameErr) nameErr.textContent = 'Name or entity is required.';
        hasError = true;
      }

      if (!emailInput?.value.trim() || !emailInput.value.includes('@')) {
        if (emailErr) emailErr.textContent = 'A valid electronic mail address is required.';
        hasError = true;
      }

      if (!msgInput?.value.trim() || msgInput.value.trim().length < 10) {
        if (msgErr) msgErr.textContent = 'Please provide at least 10 characters describing your inquiry.';
        hasError = true;
      }

      if (hasError) return;

      const subjectText = `[INQUIRY: ${catInput?.value || 'Collab'}] from ${nameInput?.value}`;
      const bodyText = `From: ${nameInput?.value} (${emailInput?.value})\nCategory: ${catInput?.value}\n\nDispatch Message:\n${msgInput?.value}\n\nSent via impure.me Transmission Dispatch`;

      const subject = encodeURIComponent(subjectText);
      const body = encodeURIComponent(bodyText);

      // Launch native email client with structured mailto
      window.location.href = `mailto:punit@builderbase.xyz?subject=${subject}&body=${body}`;

      if (successBox) {
        successBox.hidden = false;
        const copyBtn = document.getElementById('copy-payload-btn');
        if (copyBtn) {
          copyBtn.onclick = () => {
            navigator.clipboard.writeText(`Subject: ${subjectText}\nTo: punit@builderbase.xyz\n\n${bodyText}`).then(() => {
              copyBtn.innerHTML = '<span>COPIED TO CLIPBOARD! ✓</span>';
              setTimeout(() => {
                copyBtn.innerHTML = '<span>COPY MESSAGE TO CLIPBOARD</span>';
              }, 3000);
            });
          };
        }
      }
    });
  }

  setupContactForm();
  document.addEventListener('astro:page-load', setupContactForm);
</script>

