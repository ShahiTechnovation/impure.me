---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact — Punit Pal · IMPURE®"
  description="Get in touch with Punit Pal about engineering, developer communities, workshops and collaboration."
>
  <section class="container editorial-page contact-page" aria-label="Contact">
    <p class="eyebrow">Contact / Say hello</p>
    <h1 class="editorial-title">
      Let’s build
      <br />
      something useful<span class="red-period">.</span>
    </h1>
    <p class="editorial-intro">
      Have a developer tool to build, a workshop to run, or a community to bring
      together? Tell me what you’re working on and where I can help.
    </p>
    <a class="contact-email" href="mailto:punit@builderbase.xyz">
      punit@builderbase.xyz ↗
    </a>
    <div class="contact-socials">
      <button
        class="text-link copy-email"
        type="button"
        data-email="punit@builderbase.xyz"
      >
        Copy email
      </button>
      <a class="text-link" href="mailto:dev@pyvax.xyz">
        Technical enquiries ↗
      </a>
    </div>
    <p id="copy-status" role="status"></p>
  </section>
</BaseLayout>
<style>
  .contact-page {
    min-height: 72vh;
  }
  .copy-email {
    background: none;
    border: 0;
    color: inherit;
    cursor: pointer;
    font-family: inherit;
  }
  #copy-status {
    font-size: 0.8rem;
    margin-top: 12px;
  }
</style>
<script>
  const copyButton = document.querySelector<HTMLButtonElement>(".copy-email");
  copyButton?.addEventListener("click", async () => {
    const status = document.getElementById("copy-status");
    try {
      await navigator.clipboard.writeText(copyButton.dataset.email!);
      if (status) status.textContent = "Email copied.";
    } catch {
      if (status)
        status.textContent =
          "Select and copy the email address above, or open it in your mail app.";
    }
  });
</script>
