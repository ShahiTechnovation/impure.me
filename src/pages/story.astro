---
import BaseLayout from "../layouts/BaseLayout.astro";
import { storyData } from "../data/story";
---

<BaseLayout
  title="The Story — Punit Pal · IMPURE®"
  description="Why Punit Pal builds developer tools and communities, from compiler experiments to founding Builder Base."
>
  <div class="container editorial-page">
    <header class="story-intro">
      <div>
        <p class="eyebrow">Story / Punit Pal</p>
        <h1 class="editorial-title">
          Curiosity brought me
          <br />
          to the code.
          <br />
          People kept me here<span class="red-period">.</span>
        </h1>
        <p class="editorial-intro">
          I’m a developer and the founder of Builder Base, studying Computer
          Science with a focus on AI and Data Science in Bhopal.
        </p>
      </div>
      <figure>
        <img
          src="/images/punit-pal.webp"
          alt="Punit Pal in a city arcade"
          width="700"
          height="700"
        />
        <figcaption>Builder, student, and always learning.</figcaption>
      </figure>
    </header>
    <section
      class="editorial-block editorial-prose"
      aria-label="Personal story"
    >
      <h2>Making it easier to begin.</h2>
      <p>
        I started programming because I wanted to understand how systems work.
        Smart contracts made that curiosity practical: why should a developer
        have to learn a new language before trying an idea?
      </p>
      <p>
        That question led me into compilers and projects like PyVax and
        Sol2Rust. Hackathons taught me to choose a problem, make something work,
        and explain the tradeoffs clearly.
      </p>
      <p>
        Building also showed me a different kind of friction. Developers outside
        major tech hubs needed mentorship, useful documentation and people to
        learn alongside. I founded Builder Base to help close that gap, starting
        with technical meetups and study groups.
      </p>
      <p>
        Today I move between those two kinds of work: writing tools and helping
        people use them. A workshop setup problem can be as useful a starting
        point as an engineering experiment.
      </p>
      <a class="text-link" href="/build">
        Explore my work ↗
      </a>
    </section>
    <section class="editorial-block editorial-prose" aria-label="Education">
      <h2>Still a student.</h2>
      <p>
        {storyData.education.degree} · {storyData.education.specialization}
      </p>
      <p>
        {storyData.education.institution}
        <br />
        {storyData.education.location} · {storyData.education.timeline}
      </p>
      <details class="editorial-disclosure">
        <summary>Coursework and foundations</summary>
        <div>
          <ul>
            {storyData.education.coursework.map((c) => (
              <li>{c}</li>
            ))}
          </ul>
        </div>
      </details>
    </section>
    <section
      class="editorial-block editorial-prose"
      aria-label="More of the story"
    >
      <h2>The longer version.</h2>
      {storyData.narrativeSections.map((section) => (
        <details class="editorial-disclosure">
          <summary>{section.subtitle}</summary>
          <div>
            {section.content.split("\n\n").map((p) => (
              <p class="story-paragraph">{p}</p>
            ))}
          </div>
        </details>
      ))}
      <details class="editorial-disclosure">
        <summary>Milestones, 2024–2026</summary>
        <div>
          {storyData.milestones.map((m) => (
            <article class="milestone">
              <p class="eyebrow">
                {m.year} / {m.quarter}
              </p>
              <h3>{m.title}</h3>
              <p>{m.description}</p>
              <p>{m.impact}</p>
            </article>
          ))}
        </div>
      </details>
      <details class="editorial-disclosure">
        <summary>What I try to bring to the work</summary>
        <div>
          {storyData.operatingPrinciples.map((p) => (
            <article>
              <h3>{p.title}</h3>
              <p>{p.detail}</p>
            </article>
          ))}
        </div>
      </details>
    </section>
  </div>
</BaseLayout>
<style>
  .story-intro {
    display: grid;
    grid-template-columns: 1fr 260px;
    gap: 80px;
    align-items: center;
  }
  .story-intro img {
    width: 100%;
    height: auto;
    filter: grayscale(1);
  }
  .story-paragraph {
    white-space: pre-line;
  }
  .milestone {
    margin-bottom: 32px;
  }
  .milestone h3 {
    margin-top: 10px;
  }
  @media (max-width: 767px) {
    .story-intro {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    .story-intro figure {
      width: 180px;
      justify-self: end;
    }
  }
</style>
