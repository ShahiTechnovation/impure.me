---
import BaseLayout from "../layouts/BaseLayout.astro";
import GtmCaseCard from "../components/ecosystems/GtmCaseCard.astro";
import {
  builderBaseData,
  ecosystemRoles,
  gtmInitiatives,
} from "../data/ecosystems";
---

<BaseLayout
  title="Builder Base & Developer Relations — Punit Pal"
  description="The community side of Punit Pal’s work: Builder Base, technical workshops, hackathons and developer programs across India."
>
  <div class="container editorial-page">
    <header class="grow-intro">
      <div>
        <p class="eyebrow">Grow / Founder of Builder Base</p>
        <h1 class="editorial-title">
          Good tools.
          <br />
          People to build with<span class="red-period">.</span>
        </h1>
        <p class="editorial-intro">
          I started Builder Base to bring developers together around working
          code. Today, that work spans technical workshops, hackathons and
          community programs across India.
        </p>
        <a
          class="text-link"
          href="https://www.builderbase.xyz"
          target="_blank"
          rel="noopener noreferrer"
        >
          Visit Builder Base ↗
        </a>
      </div>
      <figure>
        <img
          src="/images/work/community-1.webp"
          width="1400"
          height="647"
          alt="Builder Base participants holding a community banner"
        />
        <figcaption>From the Builder Base event archive.</figcaption>
      </figure>
    </header>
    <section class="editorial-block" aria-label="Builder Base reach">
      <h2>A community with several ways in.</h2>
      <dl class="reach-strip">
        {builderBaseData.channels.map((c) => (
          <div>
            <dt>{c.channel}</dt>
            <dd>{c.reach}</dd>
          </div>
        ))}
      </dl>
      <p class="media-note">
        Owner-reported channel reach, as of October 2026. Audiences may overlap;
        these are not deduplicated members or independently verified active-user
        counts.
      </p>
      <details class="editorial-disclosure">
        <summary>How Builder Base works</summary>
        <div class="editorial-prose">
          <p>{builderBaseData.narrative}</p>
          <h3>From a first conversation to a first project</h3>
          <p>
            Regional meetups and developer outreach help people find a place to
            start. Technical dispatches introduce tools and opportunities. In
            workshops, builders clone starter repositories, set up local
            environments and work through code together.
          </p>
          <p>
            Hackathon programs give that learning a concrete challenge.
            Mentorship and introductions to grant programs or contributor
            opportunities help builders continue afterwards.
          </p>
          <h3>Distribution channels</h3>
          <ul>
            {builderBaseData.channels.map((c) => (
              <li>
                <strong>{c.channel}:</strong> {c.description}
              </li>
            ))}
          </ul>
          <h3>Ecosystems in the community’s work</h3>
          <p>{builderBaseData.partnerEcosystems.join(" · ")}</p>
          <p>
            These are areas of community activity and contributor experience,
            not a claim of formal corporate partnerships.
          </p>
        </div>
      </details>
    </section>
    <section class="editorial-block" aria-label="Developer programs">
      <p class="eyebrow">Programs / Select a case study</p>
      <h2>Work that brings people together.</h2>
      <p class="program-note">
        Program accounts and outcomes are owner-reported. Upcoming work is
        labeled separately from completed activity.
      </p>
      {gtmInitiatives.map((initiative) => (
        <details class="editorial-disclosure" id={initiative.id.toLowerCase()}>
          <summary>
            {initiative.title}
            <span class="eyebrow">
              {initiative.period} / {initiative.location}
            </span>
          </summary>
          <div>
            <GtmCaseCard initiative={initiative} />
          </div>
        </details>
      ))}
    </section>
    <section class="editorial-block" aria-label="Community roles">
      <h2>Along the way.</h2>
      <p class="program-note">
        Community and contributor roles, rather than corporate employment or
        endorsement.
      </p>
      {ecosystemRoles.map((role) => (
        <details class="editorial-disclosure">
          <summary>
            {role.organization}
            <span class="eyebrow">
              {role.role} / {role.period}
            </span>
          </summary>
          <div class="editorial-prose">
            <p>
              {role.scope} · {role.status}
            </p>
            <ul>
              {role.contributions.map((c) => (
                <li>{c}</li>
              ))}
            </ul>
          </div>
        </details>
      ))}
    </section>
    <div class="editorial-block">
      <h2>Have a program in mind?</h2>
      <a class="text-link" href="/contact">
        Let’s talk ↗
      </a>
    </div>
  </div>
</BaseLayout>
<style>
  .grow-intro {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }
  .grow-intro img {
    width: 100%;
    height: auto;
  }
  .grow-intro .text-link {
    margin-top: 24px;
  }
  .program-note {
    max-width: 65ch;
    margin-bottom: 28px;
    font-size: 0.9rem;
    color: var(--text-muted);
  }
  .editorial-block {
    max-width: 1000px;
  }
  @media (max-width: 767px) {
    .grow-intro {
      grid-template-columns: 1fr;
      gap: 30px;
    }
  }
</style>
