---
// src/pages/index.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import ArchitectureDiagram from "../components/projects/ArchitectureDiagram.astro";
import HackathonRecord from "../components/achievements/HackathonRecord.astro";
import { projects } from "../data/projects";
import { builderBaseData } from "../data/ecosystems";

const pyvax = projects.find((p) => p.slug === "pyvax")!;
const sol2rust = projects.find((p) => p.slug === "sol2rust")!;
const flowmon = projects.find((p) => p.slug === "flowmon")!;
const rustag = projects.find((p) => p.slug === "rustag")!;
const rxgr = projects.find((p) => p.slug === "rxgr")!;
const bloopa = projects.find((p) => p.slug === "bloopa")!;
const apv3rse = projects.find((p) => p.slug === "apv3rse")!;
const withClaude = projects.find((p) => p.slug === "with-claude")!;

const fieldNotes = [
  {
    date: "MARCH 2026",
    tag: "MONAD BLITZ V3",
    title: "Orchestrating 43 Agents at 10,000 TPS",
    body: "Shipped FlowMon during Monad Blitz V3. Interconnected 43 autonomous protocol agents across DeFi price oracles, yield monitors, and swap routers via Agent Message Protocol with live on-chain execution.",
    link: "/build/flowmon",
  },
  {
    date: "SEPTEMBER 2025",
    tag: "AVALANCHE TEAM1",
    title: "Lowering Python AST into EVM Opcodes",
    body: "Shipped PyVax at AVAX Kolkata. Built compiler tooling that allows Python developers to write smart contracts and compile directly to EVM bytecode for Avalanche C-Chain.",
    link: "/build/pyvax",
  },
  {
    date: "APRIL 2025",
    tag: "ARBITRUM STYLUS",
    title: "Transpiling Solidity to High-Speed Rust WASM",
    body: "Won 1st Place at Core Nexus for Sol2Rust. Transpiles Solidity state variables, functions, and modifiers into idiomatic Rust using Arbitrum Stylus SDK primitives.",
    link: "/build/sol2rust",
  },
];
---

<BaseLayout
  title="Punit Pal // IMPURE® — Technical Founder, Developer & Ecosystem GTM"
  description="I build products. I build communities. I bring them together. Personal dossier of Punit Pal across compiler engineering, AI agent infrastructure, and developer ecosystems."
>
  <!-- Section 01: Hero -->
  <section class="hero-section" aria-label="Hero Introduction">
    <div class="container hero-container">
      <!-- Top Dossier Stamp Strip -->
      <div class="hero-dossier-bar animate-reveal">
        <div class="dossier-bar-left">
          <span class="dossier-stamp signal">DOSSIER // CONFIDENTIAL</span>
          <span class="tech-label-muted">IDENTITY: PUNIT PAL</span>
          <span class="tech-micro hide-mobile">BRAND: IMPURE&reg;</span>
        </div>
        <div class="dossier-bar-right">
          <span class="tech-micro">ACADEMIC: BTECH AI &amp; DS </span>
          <span class="dossier-stamp">ACTIVE BUILDER</span>
        </div>
      </div>

      <!-- Main Typographic Composition & Portrait Grid -->
      <div class="hero-main-grid">
        <!-- Left: Oversized Typographic Composition -->
        <div class="hero-content animate-reveal">
          <h1 class="hero-display">
            PUNIT PAL<span class="signal-dot">.</span>
          </h1>

          <p class="hero-headline text-lead">
            I build products. I build communities. I bring them together.
          </p>

          <p class="hero-support text-body">
            Developer, technical founder, and ecosystem builder working across
            compiler engineering, AI agent infrastructure, high-throughput
            blockchains, and developer-led distribution.
          </p>

          <!-- Action Buttons -->
          <div class="hero-actions">
            <a href="/build" class="btn btn-primary hero-btn">
              <span>EXPLORE ENGINEERING</span>
              <span aria-hidden="true">&rarr;</span>
            </a>
            <a href="/grow" class="btn hero-btn">
              <span>ECOSYSTEM &amp; GTM</span>
              <span aria-hidden="true">&rarr;</span>
            </a>
            <button
              type="button"
              class="btn hero-cmd-btn"
              data-open-cmd
              aria-label="Search dossier with command palette"
            >
              <span class="tech-micro">EXECUTE [⌘K]</span>
            </button>
          </div>

          <!-- Social Proof & Direct Channels -->
          <div class="hero-social-strip">
            <span class="tech-micro social-label">VERIFIED CHANNELS:</span>
            <a
              href="https://github.com/ShahiTechnovation"
              target="_blank"
              rel="noopener noreferrer"
              class="social-pill tech-micro"
            >
              <span>GITHUB</span>
              <span class="ext-arrow">&nearr;</span>
            </a>
            <a
              href="https://x.com/its_punit05"
              target="_blank"
              rel="noopener noreferrer"
              class="social-pill tech-micro"
            >
              <span>X / TWITTER</span>
              <span class="ext-arrow">&nearr;</span>
            </a>
            <a
              href="https://linkedin.com/in/punit05"
              target="_blank"
              rel="noopener noreferrer"
              class="social-pill tech-micro"
            >
              <span>LINKEDIN</span>
              <span class="ext-arrow">&nearr;</span>
            </a>
            <a
              href="https://www.builderbase.xyz"
              target="_blank"
              rel="noopener noreferrer"
              class="social-pill tech-micro"
            >
              <span>BUILDER BASE</span>
              <span class="ext-arrow">&nearr;</span>
            </a>
          </div>
        </div>

        <!-- Right: Authentic Portrait in Editorial Brutalist Frame -->
        <div class="hero-portrait-wrapper animate-reveal">
          <div class="portrait-card">
            <div class="portrait-meta-top">
              <span class="tech-micro">SUBJECT: PUNIT PAL</span>
              <span class="tech-micro">LOC: IN // GLOBAL</span>
            </div>
            <div class="portrait-image-container">
              <img
                src="/images/punit-pal.jpg"
                alt="Punit Pal — Technical Founder and Developer"
                class="portrait-img"
                loading="eager"
                width="360"
                height="360"
              />
              <div class="portrait-scanline-overlay" aria-hidden="true"></div>
            </div>
            <div class="portrait-meta-bottom">
              <div class="meta-tag">
                <span class="meta-dot"></span>
                <span class="tech-micro">STATUS: ONLINE / SHIPPING</span>
              </div>
              <span class="tech-micro">SN: 5X-HACK-WINNER</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 02: Evidence Strip -->
  <section
    class="evidence-strip-section"
    aria-label="Key Proof and Credentials"
  >
    <div class="container">
      <div class="evidence-grid animate-reveal">
        <div class="evidence-cell">
          <span class="evidence-metric heading-md">5&times;</span>
          <span class="evidence-title tech-label">PODIUM FINISHES</span>
          <span class="evidence-desc text-body-sm"
            >1st Place at Arbitrum Core Nexus; 1st Runner-Up at AVAX Kolkata,
            Monad Delhi &amp; Monad Blitz; 2nd Runner-Up at BrahmaX.</span
          >
        </div>
        <div class="evidence-cell">
          <span class="evidence-metric heading-md">2&times;</span>
          <span class="evidence-title tech-label">TOP 15 SELECTIONS</span>
          <span class="evidence-desc text-body-sm"
            >Aptos Winter School 2025 (IIT Delhi, ~900 applicants) &amp; Algorand
            Hack Series 3.0.</span
          >
        </div>
        <div class="evidence-cell">
          <span class="evidence-metric heading-md">64K+</span>
          <span class="evidence-title tech-label">LUMA EVENT AUDIENCE</span>
          <span class="evidence-desc text-body-sm"
            >Total registrations across hackathons, workshops, and developer demo days.</span
          >
        </div>
        <div class="evidence-cell">
          <span class="evidence-metric heading-md">70K+</span>
          <span class="evidence-title tech-label">NEWSLETTER REACH</span>
          <span class="evidence-desc text-body-sm"
            >Active technical subscribers receiving ecosystem dispatches and bounty roundups.</span
          >
        </div>
      </div>
    </div>
  </section>

  <!-- Section 03: Selected Engineering Work (Varied Editorial Grid) -->
  <section class="section-padding" aria-label="Selected Engineering Work">
    <div class="container">
      <div class="section-header-block animate-reveal">
        <div class="section-tag-row">
          <span class="dossier-stamp signal">SECTION 03</span>
          <span class="tech-label">SELECTED ENGINEERING WORK</span>
        </div>
        <div class="section-title-row">
          <h2 class="heading-lg">
            COMPILERS, AGENT WORKFLOWS &amp; INFRASTRUCTURE
          </h2>
          <a href="/build" class="btn hide-mobile">
            <span>VIEW ALL 18 PROJECTS</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
        <p class="section-subtitle text-body">
          Selected technical systems across compiler engineering, visual multi-agent orchestration,
          and blockchain pre-execution simulation.
        </p>
      </div>

      <!-- Varied Editorial Showcase Grid -->
      <div class="editorial-work-layout animate-reveal">
        <!-- 01: PyVax (Large Featured Showcase) -->
        <article class="dossier-card editorial-feature-card">
          <div class="card-meta-bar">
            <div class="meta-left">
              <span class="card-index-pill tech-label">{pyvax.id}</span>
              <span class="card-target-pill tech-micro">{pyvax.target}</span>
              <span class="tech-micro">{pyvax.category}</span>
            </div>
            <div class="meta-right">
              <span class="dossier-stamp signal">{pyvax.placement}</span>
            </div>
          </div>
          <div class="editorial-card-body">
            <div class="editorial-title-row">
              <div>
                <h3 class="heading-md">
                  <a href={`/build/${pyvax.slug}`} class="title-link">{pyvax.title}</a>
                </h3>
                <p class="text-lead project-one-liner">{pyvax.headline}</p>
              </div>
              <span class="card-role tech-micro">{pyvax.role}</span>
            </div>
            <p class="text-body-sm card-summary-text">{pyvax.summary}</p>
            <ArchitectureDiagram slug={pyvax.slug} variant="featured" />
            <div class="card-stack-list">
              {pyvax.stack.map((t) => (
                <span class="stack-pill tech-micro">{t}</span>
              ))}
            </div>
          </div>
          <div class="card-footer">
            <a href={`/build/${pyvax.slug}`} class="btn btn-primary card-action-btn">
              <span>INSPECT DOSSIER</span>
              <span aria-hidden="true">&rarr;</span>
            </a>
            <div class="card-secondary-links">
              <a href={pyvax.repoUrl} target="_blank" rel="noopener noreferrer" class="btn card-icon-btn" title="View Source on GitHub">
                <span>GITHUB</span>
                <span class="ext-arrow">&nearr;</span>
              </a>
              {pyvax.demoUrl && (
                <a href={pyvax.demoUrl} target="_blank" rel="noopener noreferrer" class="btn card-icon-btn" title="Live Documentation">
                  <span>LIVE SITE</span>
                  <span class="ext-arrow">&nearr;</span>
                </a>
              )}
            </div>
          </div>
        </article>

        <!-- 02: Sol2Rust (Large Featured Showcase) -->
        <article class="dossier-card editorial-feature-card">
          <div class="card-meta-bar">
            <div class="meta-left">
              <span class="card-index-pill tech-label">{sol2rust.id}</span>
              <span class="card-target-pill tech-micro">{sol2rust.target}</span>
              <span class="tech-micro">{sol2rust.category}</span>
            </div>
            <div class="meta-right">
              <span class="dossier-stamp solid-signal">{sol2rust.placement}</span>
            </div>
          </div>
          <div class="editorial-card-body">
            <div class="editorial-title-row">
              <div>
                <h3 class="heading-md">
                  <a href={`/build/${sol2rust.slug}`} class="title-link">{sol2rust.title}</a>
                </h3>
                <p class="text-lead project-one-liner">{sol2rust.headline}</p>
              </div>
              <span class="card-role tech-micro">{sol2rust.role}</span>
            </div>
            <p class="text-body-sm card-summary-text">{sol2rust.summary}</p>
            <ArchitectureDiagram slug={sol2rust.slug} variant="featured" />
            <div class="card-stack-list">
              {sol2rust.stack.map((t) => (
                <span class="stack-pill tech-micro">{t}</span>
              ))}
            </div>
          </div>
          <div class="card-footer">
            <a href={`/build/${sol2rust.slug}`} class="btn btn-primary card-action-btn">
              <span>INSPECT DOSSIER</span>
              <span aria-hidden="true">&rarr;</span>
            </a>
            <div class="card-secondary-links">
              <a href={sol2rust.repoUrl} target="_blank" rel="noopener noreferrer" class="btn card-icon-btn" title="View Source on GitHub">
                <span>GITHUB</span>
                <span class="ext-arrow">&nearr;</span>
              </a>
              {sol2rust.demoUrl && (
                <a href={sol2rust.demoUrl} target="_blank" rel="noopener noreferrer" class="btn card-icon-btn" title="Live Deployment">
                  <span>LIVE DEMO</span>
                  <span class="ext-arrow">&nearr;</span>
                </a>
              )}
            </div>
          </div>
        </article>

        <!-- 03: FlowMon (Prominent Agent-Workflow Showcase) -->
        <article class="dossier-card editorial-feature-card flowmon-spotlight">
          <div class="card-meta-bar">
            <div class="meta-left">
              <span class="card-index-pill tech-label">{flowmon.id}</span>
              <span class="card-target-pill tech-micro">{flowmon.target}</span>
              <span class="tech-micro">{flowmon.category}</span>
            </div>
            <div class="meta-right">
              <span class="dossier-stamp signal">{flowmon.placement}</span>
            </div>
          </div>
          <div class="editorial-card-body">
            <div class="editorial-title-row">
              <div>
                <h3 class="heading-md">
                  <a href={`/build/${flowmon.slug}`} class="title-link">{flowmon.title}</a>
                </h3>
                <p class="text-lead project-one-liner">{flowmon.headline}</p>
              </div>
              <span class="card-role tech-micro">{flowmon.role}</span>
            </div>
            <p class="text-body-sm card-summary-text">{flowmon.summary}</p>
            <ArchitectureDiagram slug={flowmon.slug} variant="featured" />
            <div class="card-stack-list">
              {flowmon.stack.map((t) => (
                <span class="stack-pill tech-micro">{t}</span>
              ))}
            </div>
          </div>
          <div class="card-footer">
            <a href={`/build/${flowmon.slug}`} class="btn btn-primary card-action-btn">
              <span>INSPECT DOSSIER</span>
              <span aria-hidden="true">&rarr;</span>
            </a>
            <div class="card-secondary-links">
              <a href={flowmon.repoUrl} target="_blank" rel="noopener noreferrer" class="btn card-icon-btn" title="View Source on GitHub">
                <span>GITHUB</span>
                <span class="ext-arrow">&nearr;</span>
              </a>
              {flowmon.demoUrl && (
                <a href={flowmon.demoUrl} target="_blank" rel="noopener noreferrer" class="btn card-icon-btn" title="Live Deployment">
                  <span>LIVE DEMO</span>
                  <span class="ext-arrow">&nearr;</span>
                </a>
              )}
            </div>
          </div>
        </article>

        <!-- 04 & 05: Paired Technical Projects (RustAG & RxGR) -->
        <div class="paired-projects-grid">
          <!-- RustAG -->
          <article class="dossier-card paired-card">
            <div class="card-meta-bar">
              <div class="meta-left">
                <span class="card-index-pill tech-label">{rustag.id}</span>
                <span class="card-target-pill tech-micro">{rustag.target}</span>
              </div>
              <span class="dossier-stamp">{rustag.category}</span>
            </div>
            <div class="editorial-card-body">
              <h3 class="heading-sm">
                <a href={`/build/${rustag.slug}`} class="title-link">{rustag.title}</a>
              </h3>
              <p class="tech-micro project-sub-headline">{rustag.headline}</p>
              <p class="text-body-sm card-summary-text">{rustag.summary}</p>
              <ArchitectureDiagram slug={rustag.slug} variant="compact" />
              <div class="card-stack-list">
                {rustag.stack.slice(0, 4).map((t) => (
                  <span class="stack-pill tech-micro">{t}</span>
                ))}
              </div>
            </div>
            <div class="card-footer">
              <a href={`/build/${rustag.slug}`} class="btn btn-primary card-action-btn">
                <span>INSPECT DOSSIER</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
              <a href={rustag.repoUrl} target="_blank" rel="noopener noreferrer" class="btn card-icon-btn">
                <span>GITHUB</span>
                <span class="ext-arrow">&nearr;</span>
              </a>
            </div>
          </article>

          <!-- RxGR -->
          <article class="dossier-card paired-card">
            <div class="card-meta-bar">
              <div class="meta-left">
                <span class="card-index-pill tech-label">{rxgr.id}</span>
                <span class="card-target-pill tech-micro">{rxgr.target}</span>
              </div>
              <span class="dossier-stamp">{rxgr.category}</span>
            </div>
            <div class="editorial-card-body">
              <h3 class="heading-sm">
                <a href={`/build/${rxgr.slug}`} class="title-link">{rxgr.title}</a>
              </h3>
              <p class="tech-micro project-sub-headline">{rxgr.headline}</p>
              <p class="text-body-sm card-summary-text">{rxgr.summary}</p>
              <ArchitectureDiagram slug={rxgr.slug} variant="compact" />
              <div class="card-stack-list">
                {rxgr.stack.slice(0, 4).map((t) => (
                  <span class="stack-pill tech-micro">{t}</span>
                ))}
              </div>
            </div>
            <div class="card-footer">
              <a href={`/build/${rxgr.slug}`} class="btn btn-primary card-action-btn">
                <span>INSPECT DOSSIER</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
              <a href={rxgr.repoUrl} target="_blank" rel="noopener noreferrer" class="btn card-icon-btn">
                <span>GITHUB</span>
                <span class="ext-arrow">&nearr;</span>
              </a>
            </div>
          </article>
        </div>

        <!-- 06 & 07: Paired Specialized Projects (Bloopa & APV3RSE) -->
        <div class="paired-projects-grid">
          <!-- Bloopa -->
          <article class="dossier-card paired-card">
            <div class="card-meta-bar">
              <div class="meta-left">
                <span class="card-index-pill tech-label">{bloopa.id}</span>
                <span class="card-target-pill tech-micro">{bloopa.target}</span>
              </div>
              <div class="meta-right">
                <span class="dossier-stamp signal">{bloopa.placement}</span>
              </div>
            </div>
            <div class="editorial-card-body">
              <h3 class="heading-sm">
                <a href={`/build/${bloopa.slug}`} class="title-link">{bloopa.title}</a>
              </h3>
              <p class="tech-micro project-sub-headline">{bloopa.headline}</p>
              <p class="text-body-sm card-summary-text">{bloopa.summary}</p>
              <ArchitectureDiagram slug={bloopa.slug} variant="compact" />
              <div class="card-stack-list">
                {bloopa.stack.slice(0, 4).map((t) => (
                  <span class="stack-pill tech-micro">{t}</span>
                ))}
              </div>
            </div>
            <div class="card-footer">
              <a href={`/build/${bloopa.slug}`} class="btn btn-primary card-action-btn">
                <span>INSPECT DOSSIER</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
              <a href={bloopa.repoUrl} target="_blank" rel="noopener noreferrer" class="btn card-icon-btn">
                <span>GITHUB</span>
                <span class="ext-arrow">&nearr;</span>
              </a>
            </div>
          </article>

          <!-- APV3RSE -->
          <article class="dossier-card paired-card">
            <div class="card-meta-bar">
              <div class="meta-left">
                <span class="card-index-pill tech-label">{apv3rse.id}</span>
                <span class="card-target-pill tech-micro">{apv3rse.target}</span>
              </div>
              <div class="meta-right">
                <span class="dossier-stamp signal">{apv3rse.placement}</span>
              </div>
            </div>
            <div class="editorial-card-body">
              <h3 class="heading-sm">
                <a href={`/build/${apv3rse.slug}`} class="title-link">{apv3rse.title}</a>
              </h3>
              <p class="tech-micro project-sub-headline">{apv3rse.headline}</p>
              <p class="text-body-sm card-summary-text">{apv3rse.summary}</p>
              <ArchitectureDiagram slug={apv3rse.slug} variant="compact" />
              <div class="card-stack-list">
                {apv3rse.stack.slice(0, 4).map((t) => (
                  <span class="stack-pill tech-micro">{t}</span>
                ))}
              </div>
            </div>
            <div class="card-footer">
              <a href={`/build/${apv3rse.slug}`} class="btn btn-primary card-action-btn">
                <span>INSPECT DOSSIER</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
              <div class="card-secondary-links">
                <a href={apv3rse.repoUrl} target="_blank" rel="noopener noreferrer" class="btn card-icon-btn">
                  <span>GITHUB</span>
                  <span class="ext-arrow">&nearr;</span>
                </a>
                {apv3rse.demoUrl && (
                  <a href={apv3rse.demoUrl} target="_blank" rel="noopener noreferrer" class="btn card-icon-btn">
                    <span>LIVE</span>
                    <span class="ext-arrow">&nearr;</span>
                  </a>
                )}
              </div>
            </div>
          </article>
        </div>

        <!-- 08: With Claude (Full-Width Real-World Product Case Study) -->
        <article class="dossier-card editorial-feature-card with-claude-showcase">
          <div class="card-meta-bar">
            <div class="meta-left">
              <span class="card-index-pill tech-label">{withClaude.id}</span>
              <span class="card-target-pill tech-micro">{withClaude.target}</span>
              <span class="tech-micro">{withClaude.category}</span>
            </div>
            <div class="meta-right">
              <span class="dossier-stamp">{withClaude.status}</span>
            </div>
          </div>
          <div class="editorial-card-body">
            <div class="editorial-title-row">
              <div>
                <h3 class="heading-md">
                  <a href={`/build/${withClaude.slug}`} class="title-link">{withClaude.title}</a>
                </h3>
                <p class="text-lead project-one-liner">{withClaude.headline}</p>
              </div>
              <span class="card-role tech-micro">{withClaude.role}</span>
            </div>
            <p class="text-body-sm card-summary-text">{withClaude.summary}</p>
            <ArchitectureDiagram slug={withClaude.slug} variant="featured" />
            <div class="card-stack-list">
              {withClaude.stack.map((t) => (
                <span class="stack-pill tech-micro">{t}</span>
              ))}
            </div>
          </div>
          <div class="card-footer">
            <a href={`/build/${withClaude.slug}`} class="btn btn-primary card-action-btn">
              <span>INSPECT DOSSIER</span>
              <span aria-hidden="true">&rarr;</span>
            </a>
            <div class="card-secondary-links">
              <a href={withClaude.repoUrl} target="_blank" rel="noopener noreferrer" class="btn card-icon-btn" title="View Source on GitHub">
                <span>GITHUB</span>
                <span class="ext-arrow">&nearr;</span>
              </a>
            </div>
          </div>
        </article>
      </div>

      <div class="section-footer-cta animate-reveal">
        <a href="/build" class="btn" style="width: 100%; justify-content: center; padding: 16px;">
          <span>EXPLORE COMPLETE ENGINEERING ARCHIVE (18 PROJECTS &amp; PROTOCOLS)</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
