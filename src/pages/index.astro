---
import EngineeringVisual from "../components/projects/EngineeringVisual.astro";
import BuilderFlag from "../components/ecosystems/BuilderFlag.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects } from "../data/projects";
import { achievements } from "../data/achievements";
const selected = ["pyvax", "sol2rust", "flowmon"].map((slug) =>
  projects.find((p) => p.slug === slug)!,
);
const summaries = [
  "Python smart contracts, lowered to EVM bytecode. A compiler and CLI for Avalanche.",
  "An AI-assisted Solidity-to-Rust prototype, exploring the path to Arbitrum Stylus.",
  "Connect protocol agents on a visual canvas. Define a workflow, inspect its dependencies, and explore the tools behind it.",
];
const supporting = [
  {
    slug: "rustag",
    name: "RustAG",
    category: "Solana infrastructure",
    tech: "Rust / Solana",
    description:
      "Pre-execution transaction simulation for Solana.",
  },
  {
    slug: "rxgr",
    name: "RxGR",
    category: "AI research",
    tech: "Python / GraphRAG",
    description:
      "Explore drug–disease relationships with biomedical knowledge graphs.",
  },
  {
    slug: "with-claude",
    name: "With Claude",
    category: "Community publishing",
    tech: "Astro / PostgreSQL",
    description:
      "A place to discover and share projects built with Claude.",
  },
];
---

<BaseLayout
  title="Punit Pal — Developer, Founder & Ecosystem Builder · IMPURE®"
  description="I build products. I build communities. I bring them together. Explore Punit Pal’s developer tools, AI infrastructure and work with Builder Base."
>
  <div class="editorial-home">
    <section class="identity container" aria-label="Identity">
      <div class="identity-copy">
        <p class="eyebrow">Developer / Founder / Ecosystem builder</p>
        <h1>
          PUNIT PAL<span class="red-period">.</span>
        </h1>
        <p class="identity-line">
          I build products.
          <br />I build communities.
          <br />
          <span>I bring them together.</span>
        </p>
        <p class="identity-support">
          Building developer tools, AI infrastructure, and communities that help
          people ship.
        </p>
        <div class="editorial-actions">
          <a class="btn btn-primary" href="#selected-work">
            Explore work <span aria-hidden="true">↘</span>
          </a>
          <a class="text-link" href="/story">
            About me <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
      <figure class="identity-photo">
        <img
          src="/images/punit-pal.webp"
          srcset="/images/punit-pal-460.webp 460w, /images/punit-pal.webp 700w"
          sizes="(max-width: 767px) 230px, 280px"
          alt="Punit Pal, photographed in a city arcade"
          width="700"
          height="700"
          fetchpriority="high"
        />
        <figcaption>Punit Pal / India</figcaption>
      </figure>
    </section>

    <section
      class="editorial-section container"
      id="selected-work"
      aria-label="Selected work"
    >
      <header class="editorial-heading">
        <p class="eyebrow">01 / Selected work</p>
        <h2>
          Tools for the
          <br />
          people building next.
        </h2>
        <p>
          Compilers, developer tools and agent workflows. Three ways of making the next build possible.
        </p>
      </header>
      <div class="flagship-grid">
        {selected.map((project, i) => (
          <article class:list={["flagship", `flagship-${project.slug}`]}>
            <EngineeringVisual slug={project.slug} />
            <div class="flagship-copy">
              <p class="eyebrow">
                {i === 0
                  ? "Python / Avalanche"
                  : i === 1
                    ? "Solidity / Rust / AI"
                    : "TypeScript / Monad"}
              </p>
              <h3>
                <a href={`/build/${project.slug}`}>{project.title}</a>
              </h3>
              <p>{summaries[i]}</p>
              <p class="project-result">
                {project.placement} ·{" "}
                {i === 0
                  ? "AVAX Kolkata"
                  : i === 1
                    ? "Core Nexus"
                    : "Monad Blitz V3"}
              </p>
              <div class="project-links">
                <a class="text-link" href={`/build/${project.slug}`}>
                  Case study <span aria-hidden="true">↗</span>
                </a>
                <a
                  href={project.repoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  GitHub ↗
                </a>
                {i !== 0 && (
                  <a
                    href={project.demoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Demo ↗
                  </a>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
      <div class="supporting-projects">
        {supporting.map((p) => (
          <a class="supporting-row" href={`/build/${p.slug}`}>
            <h3>{p.name}</h3>
            <div>
              <span class="eyebrow">{p.category}</span>
              <p>{p.description}</p><span class="supporting-tech">{p.tech}</span>
            </div>
            <span class="row-arrow" aria-label="View project">
              ↗
            </span>
          </a>
        ))}
      </div>
      <div class="archive-invitation">
        <p>
          More experiments, prototypes and engineering notes.
        </p>
        <a class="text-link" href="/build">
          Explore all {projects.length} projects{" "}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <section class="community-section" aria-label="Founder of Builder Base">
      <div class="container community-grid">
        <div class="founder-copy">
          <p class="eyebrow">02 / Founder</p>
          <h2>Builder Base<span class="red-period">.</span></h2>
          <p class="founder-position">The distribution layer for builders.</p>
          <p class="community-lead">I founded Builder Base to bring developers closer to the tools, people, and opportunities they need to build.</p>
          <p class="founder-detail">Workshops, hackathons and developer programs across India.</p>
          <a class="text-link" href="/grow">Meet the community <span aria-hidden="true">↗</span></a>
        </div>
        <BuilderFlag />
        <figure class="founder-photo">
          <img src="/images/work/community-1.webp" width="1400" height="647" alt="Builders gathered around the Builder Base banner at a community event" loading="lazy" />
          <figcaption>From the Builder Base public photo archive. <a href="https://www.builderbase.xyz/" target="_blank" rel="noopener noreferrer">Source ↗</a></figcaption>
        </figure>
        <div class="founder-footnote"><p>Good tools need people to build with.</p><a class="text-link" href="/grow#selected-programs">Selected programs ↗</a></div>
      </div>
    </section>

    <section class="editorial-section container" aria-label="Recognition">
      <header class="editorial-heading recognition-heading">
        <p class="eyebrow">03 / Recognition</p>
        <h2>Built under pressure.</h2>
        <p>
          Five podium finishes, each with a different problem to solve. Two
          further projects received Top 15 recognition.
        </p>
      </header>
      <div class="recognition-list">
        {achievements
          .filter((a) => a.placementType !== "finalist")
          .map((a) => (
            <div class="recognition-row">
              <span class="award-year">{a.date.split(" ").at(-1)}</span>
              <a
                class="award-event"
                href={a.evidenceUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${a.competition} event page`}
              >
                {a.competition.replace(" (Team1 Hack25)", "")} ↗
              </a>
              <strong>{a.placement}</strong>
              <a class="award-project" href={`/build/${a.projectSlug}`}>
                {a.projectTitle} ↗
              </a>
            </div>
          ))}
      </div>
      <div class="finalist-list">
        {achievements
          .filter((a) => a.placementType === "finalist")
          .map((a) => (
            <p>
              <a class="text-link" href={`/build/${a.projectSlug}`}>
                {a.projectTitle}
              </a>{" "}
              · {a.placement} ·{" "}
              <a
                class="evidence-link"
                href={a.evidenceUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                {a.competition} ↗
              </a>
            </p>
          ))}
      </div>
      <p class="media-note">
        Placements are owner-reported. Event and project links provide context;
        they are not independently verified award certificates.
      </p>
    </section>

    <section class="home-contact container" aria-label="Contact">
      <p class="eyebrow">04 / Get in touch</p>
      <h2>
        Let’s build
        <br />
        something useful<span class="red-period">.</span>
      </h2>
      <div>
        <p>
          A developer tool, a technical workshop, or a community with a reason
          to exist. Tell me what you’re working on.
        </p>
        <a class="text-link" href="mailto:punit@builderbase.xyz">
          punit@builderbase.xyz ↗
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
