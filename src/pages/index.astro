---
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects } from "../data/projects";
import { achievements } from "../data/achievements";
const selected = ["pyvax", "sol2rust", "flowmon"].map((slug) =>
  projects.find((p) => p.slug === slug)!,
);
const summaries = [
  "Write smart contracts in Python. PyVax compiles them to EVM bytecode for Avalanche, bringing a familiar language to on-chain development.",
  "Move Solidity contracts into Rust for Arbitrum Stylus, with a transpiler that connects existing smart-contract code to a different execution environment.",
  "Compose on-chain AI-agent workflows on a visual canvas. Connect protocol agents, define their dependencies, and follow the flow from input to execution.",
];
const supporting = [
  {
    slug: "rustag",
    name: "RustAG",
    category: "Solana infrastructure",
    description:
      "Simulate privileged transactions before execution, checking account ownership and balance invariants against a local state fork.",
  },
  {
    slug: "rxgr",
    name: "RxGR",
    category: "AI research",
    description:
      "Explore drug–disease relationships through biomedical knowledge graphs and retrieval, with a research prototype built around connected evidence.",
  },
  {
    slug: "with-claude",
    name: "With Claude",
    category: "Community publishing",
    description:
      "Discover and share projects built with Claude through a publishing platform using Astro, React islands, Neon and Drizzle.",
  },
];
---

<BaseLayout
  title="Punit Pal — Developer, Founder & Ecosystem Builder · IMPURE®"
  description="I build products. I build communities. I bring them together. Explore Punit Pal’s developer tools, AI infrastructure and work with Builder Base."
>
  <div class="editorial-home">
    <section class="identity container" aria-label="Identity">
      <div class="identity-copy">
        <p class="eyebrow">Developer / Founder / Ecosystem builder</p>
        <h1>
          PUNIT PAL<span class="red-period">.</span>
        </h1>
        <p class="identity-line">
          I build products.
          <br />I build communities.
          <br />
          <span>I bring them together.</span>
        </p>
        <p class="identity-support">
          Building developer tools, AI infrastructure, and communities that help
          people ship.
        </p>
        <div class="editorial-actions">
          <a class="btn btn-primary" href="#selected-work">
            Explore work <span aria-hidden="true">↘</span>
          </a>
          <a class="text-link" href="/story">
            About me <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
      <figure class="identity-photo">
        <img
          src="/images/punit-pal.webp"
          srcset="/images/punit-pal-460.webp 460w, /images/punit-pal.webp 700w"
          sizes="(max-width: 767px) 230px, 280px"
          alt="Punit Pal, photographed in a city arcade"
          width="700"
          height="700"
          fetchpriority="high"
        />
        <figcaption>Punit Pal / India</figcaption>
      </figure>
    </section>

    <section
      class="editorial-section container"
      id="selected-work"
      aria-label="Selected work"
    >
      <header class="editorial-heading">
        <p class="eyebrow">01 / Selected work</p>
        <h2>
          Tools for the
          <br />
          people building next.
        </h2>
        <p>
          From a familiar programming language to a new execution environment, I
          work on the tools between an idea and working software. These three
          projects trace that interest across compilers and agent workflows. The
          case studies explain what I built, how it works, and the tradeoffs
          along the way.
        </p>
      </header>
      <div class="flagship-grid">
        {selected.map((project, i) => (
          <article class:list={["flagship", `flagship-${project.slug}`]}>
            <a
              href={`/build/${project.slug}`}
              class="project-visual"
              aria-label={
                i === 0 ? undefined : `Read the ${project.title} case study`
              }
            >
              {i === 0 ? (
                <div class="compiler-visual">
                  <span class="eyebrow">PyVax / Compiler overview</span>
                  <div class="compiler-languages">
                    <span>Python</span>
                    <span class="compiler-arrow" aria-hidden="true">
                      ↓
                    </span>
                    <span>
                      EVM<span class="red-period">.</span>
                    </span>
                  </div>
                  <span class="compiler-caption">
                    Python source → bytecode → Avalanche C-Chain
                  </span>
                </div>
              ) : (
                <img
                  src={`/images/work/${project.slug}.webp`}
                  alt={
                    i === 1
                      ? "Sol2Rust converter showing a Solidity editor and Rust output pane"
                      : "FlowMon application with its built-in demo workflow loaded on the agent canvas"
                  }
                  width={i === 1 ? 1220 : 1440}
                  height={i === 1 ? 685 : 960}
                  loading="lazy"
                />
              )}
            </a>
            <div class="flagship-copy">
              <p class="eyebrow">
                {i === 0
                  ? "Python / Avalanche"
                  : i === 1
                    ? "Rust / Arbitrum Stylus"
                    : "TypeScript / Monad"}
              </p>
              <h3>
                <a href={`/build/${project.slug}`}>{project.title}</a>
              </h3>
              <p>{summaries[i]}</p>
              <p class="project-result">
                {project.placement} ·{" "}
                {i === 0
                  ? "AVAX Kolkata"
                  : i === 1
                    ? "Core Nexus"
                    : "Monad Blitz V3"}
              </p>
              <div class="project-links">
                <a class="text-link" href={`/build/${project.slug}`}>
                  Case study <span aria-hidden="true">↗</span>
                </a>
                <a
                  href={project.repoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  GitHub ↗
                </a>
                {i !== 0 && (
                  <a
                    href={project.demoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Demo ↗
                  </a>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
      <p class="media-note">
        Product screens captured from the public demos. PyVax is shown as a
        compiler overview; its live site is currently unavailable. Screens
        illustrate the interface, not a benchmark or production guarantee.
      </p>
      <div class="supporting-projects">
        {supporting.map((p) => (
          <a class="supporting-row" href={`/build/${p.slug}`}>
            <h3>{p.name}</h3>
            <div>
              <span class="eyebrow">{p.category}</span>
              <p>{p.description}</p>
            </div>
            <span class="row-arrow" aria-label="View project">
              ↗
            </span>
          </a>
        ))}
      </div>
      <div class="archive-invitation">
        <p>
          The wider archive includes APV3RSE, Bloopa, NeuroFit, PyMon and
          experiments in developer infrastructure. Each project keeps its
          implementation notes, source links and technical decisions.
        </p>
        <a class="text-link" href="/build">
          Explore all {projects.length} projects{" "}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <section class="community-section" aria-label="Beyond engineering">
      <div class="container community-grid">
        <div>
          <p class="eyebrow">02 / Beyond engineering</p>
          <h2>
            Code meets
            <br />
            community<span class="red-period">.</span>
          </h2>
          <p class="community-lead">
            I founded Builder Base to connect developers with the tools, people,
            and opportunities they need to build.
          </p>
        </div>
        <div class="community-story">
          <p>
            That means sitting beside someone debugging their first deployment,
            preparing a workshop that starts with working code, and creating
            places where builders can find each other.
          </p>
          <p>
            My Developer Relations and ecosystem work brings together technical
            workshops, hackathon programs, developer documentation and community
            distribution across India. Engineering gives me something useful to
            share; community helps me understand what to build next.
          </p>
          <a class="text-link" href="/grow">
            Explore ecosystem work <span aria-hidden="true">↗</span>
          </a>
        </div>
        <dl class="reach-strip">
          <div>
            <dt>Luma registrations</dt>
            <dd>64K+</dd>
          </div>
          <div>
            <dt>Newsletter reach</dt>
            <dd>70K+</dd>
          </div>
          <div>
            <dt>WhatsApp circles</dt>
            <dd>2K+</dd>
          </div>
        </dl>
        <p class="reach-note">
          Owner-reported channel reach. These figures can overlap and do not
          represent unique active members.
        </p>
      </div>
    </section>

    <section class="editorial-section container" aria-label="Recognition">
      <header class="editorial-heading recognition-heading">
        <p class="eyebrow">03 / Recognition</p>
        <h2>Built under pressure.</h2>
        <p>
          Five podium finishes, each with a different problem to solve. Two
          further projects received Top 15 recognition.
        </p>
      </header>
      <div class="recognition-list">
        {achievements
          .filter((a) => a.placementType !== "finalist")
          .map((a) => (
            <div class="recognition-row">
              <span class="award-year">{a.date.split(" ").at(-1)}</span>
              <a
                class="award-event"
                href={a.evidenceUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${a.competition} event page`}
              >
                {a.competition.replace(" (Team1 Hack25)", "")} ↗
              </a>
              <strong>{a.placement}</strong>
              <a class="award-project" href={`/build/${a.projectSlug}`}>
                {a.projectTitle} ↗
              </a>
            </div>
          ))}
      </div>
      <div class="finalist-list">
        {achievements
          .filter((a) => a.placementType === "finalist")
          .map((a) => (
            <p>
              <a class="text-link" href={`/build/${a.projectSlug}`}>
                {a.projectTitle}
              </a>{" "}
              · {a.placement} ·{" "}
              <a
                class="evidence-link"
                href={a.evidenceUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                {a.competition} ↗
              </a>
            </p>
          ))}
      </div>
      <p class="media-note">
        Placements are owner-reported. Event and project links provide context;
        they are not independently verified award certificates.
      </p>
    </section>

    <section
      class="editorial-section field-section container"
      aria-label="Field notes"
    >
      <header class="editorial-heading">
        <p class="eyebrow">04 / Field notes</p>
        <h2>Beyond the screen.</h2>
        <p>
          A few moments from the communities around the code. Photographs from
          Builder Base’s public event archive, with the people and conversations
          that give this work its purpose.
        </p>
      </header>
      <div class="field-grid">
        <figure>
          <img
            src="/images/work/community-1.webp"
            width="1400"
            height="647"
            alt="Builder Base participants gathered together holding a community banner"
            loading="lazy"
          />
          <figcaption>
            01 / The people behind Builder Base. A community gathering, shared
            in the event archive.
          </figcaption>
        </figure>
        <figure>
          <img
            src="/images/work/community-2.webp"
            width="1280"
            height="960"
            alt="Claude Community participants gathered in an auditorium in Bhopal"
            loading="lazy"
          />
          <figcaption>
            02 / Claude Community, Bhopal. A room full of builders, photographed
            together after a community session.
          </figcaption>
        </figure>
      </div>
      <a
        class="text-link photo-source"
        href="https://www.builderbase.xyz"
        target="_blank"
        rel="noopener noreferrer"
      >
        From the Builder Base archive ↗
      </a>
    </section>

    <section class="home-contact container" aria-label="Contact">
      <p class="eyebrow">05 / Get in touch</p>
      <h2>
        Let’s build
        <br />
        something useful<span class="red-period">.</span>
      </h2>
      <div>
        <p>
          A developer tool, a technical workshop, or a community with a reason
          to exist. Tell me what you’re working on.
        </p>
        <a class="text-link" href="mailto:punit@builderbase.xyz">
          punit@builderbase.xyz ↗
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
